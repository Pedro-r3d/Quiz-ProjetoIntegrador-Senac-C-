create table Historico (
Id serial primary key,
UsuarioId int not null,
DataDoQuiz date not null,
Pontos int not null,
foreign key (UsuarioId) references usuario(Id)
)

create table Registro (
Id serial primary key,
HistoricoId int not null,
Pergunta varchar(255) not null,
Tema varchar(50) not null,
Correta bool not null,
valor int not null,
foreign key (HistoricoId) references Historico(Id)
)

create table Pergunta(
Id serial primary key,
Questao varchar(255) not null,
Tipo varchar(255) not null,
Nivel varchar(50) not null,
Tema varchar(50) not null,
Pontos int not null,
foreign key (TipoId) references Alternativas(Id)
)

create table Alternativas(
Id serial primary key,
PerguntaId int not null,
Correta varchar(255) not null,
EscolhaA varchar(255) not null,
EscolhaB varchar(255) not null,
EscolhaC varchar(255) not null,
foreign key (PerguntaId) references Pergunta(Id)
)

create table VerdadeiroOuFalso(
Id serial primary key,
PerguntaId int not null,
Correta varchar(255) not null,
Errada varchar(255) not null,
foreign key (PerguntaId) references Pergunta(Id)
)
